{
  "openapi": "3.0.3",
  "info": {
    "title": "Collaborative Notes API",
    "version": "1.2.0",
    "description": "API разделено на модули: авторизация, управление заметками по идентификатору и публичный доступ по share-токену."
  },
  "servers": [
    {
      "url": "http://localhost:8080/api/v1"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Авторизация и регистрация пользователей"
    },
    {
      "name": "Notes",
      "description": "Управление своими заметками (только для создателя/редакторов по UUID)"
    },
    {
      "name": "Shared",
      "description": "Доступ к чужим заметкам по share-токену"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Регистрация нового пользователя",
        "operationId": "registerUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuthRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Пользователь создан",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Вход в систему",
        "operationId": "loginUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuthRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успешная авторизация",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JwtResponse" }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Обновить пользовательскую сессию",
        "operationId": "refreshSession",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshTokenRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Сессия обновлена, прежний refresh-токен отозван",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JwtResponse" }
              }
            }
          },
          "401": { "description": "Refresh-токен недействителен или просрочен" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Завершить пользовательскую сессию",
        "operationId": "logoutUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshTokenRequest" }
            }
          }
        },
        "responses": {
          "204": { "description": "Сессия завершена" }
        }
      }
    },
    "/notes": {
      "post": {
        "tags": ["Notes"],
        "summary": "Создать новую заметку",
        "security": [{ "BearerAuth": [] }],
        "operationId": "createNote",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NoteCreateRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Заметка создана",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Note" }
              }
            }
          }
        }
      }
    },
    "/notes/{id}": {
      "get": {
        "tags": ["Notes"],
        "summary": "Получить свою заметку по ID",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Успешно",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Note" }
              }
            }
          },
          "403": { "description": "Доступ запрещен (не владелец)" }
        }
      },
      "patch": {
        "tags": ["Notes"],
        "summary": "Обновить свою заметку (генерирует diff)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NoteUpdateRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Успешно обновлено" },
          "403": { "description": "Доступ запрещен" },
          "409": { "description": "Конфликт версий (Optimistic Locking)" }
        }
      }
    },
    "/notes/{id}/tokens": {
      "post": {
        "tags": ["Notes"],
        "summary": "Сгенерировать share-токен для заметки",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TokenCreateRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Токен создан",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Token" }
              }
            }
          }
        }
      }
    },
    "/notes/shared/{token}": {
      "get": {
        "tags": ["Shared"],
        "summary": "Получить чужую заметку по токену",
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "required": true,
            "description": "Сгенерированный share-токен",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Заметка получена",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Note" }
              }
            }
          },
          "401": { "description": "Токен недействителен или просрочен" }
        }
      },
      "patch": {
        "tags": ["Shared"],
        "summary": "Редактировать чужую заметку по токену",
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NoteUpdateRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Успешно обновлено" },
          "403": { "description": "Токен дает право только на чтение, запись запрещена" },
          "409": { "description": "Конфликт версий" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "AuthRequest": {
        "type": "object",
        "required": ["login", "password"],
        "properties": {
          "login": { "type": "string" },
          "password": { "type": "string", "format": "password" }
        }
      },
      "UserResponse": {
        "type": "object",
        "required": ["id", "login", "createdAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "login": { "type": "string" },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Время создания пользователя в UTC, устанавливаемое сервером"
          }
        }
      },
      "JwtResponse": {
        "type": "object",
        "required": ["accessToken", "refreshToken", "expiresAt"],
        "properties": {
          "accessToken": { "type": "string" },
          "refreshToken": { "type": "string" },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Время истечения access-токена в UTC"
          }
        }
      },
      "RefreshTokenRequest": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": { "type": "string" }
        }
      },
      "Note": {
        "type": "object",
        "required": ["id", "title", "markdown", "revision", "createdAt", "updatedAt", "expiredAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": {
            "type": "string",
            "description": "Краткое название заметки для отображения в списке и заголовке страницы"
          },
          "markdown": { "type": "string" },
          "revision": { "type": "integer", "format": "int64" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "expiredAt": { "type": "string", "format": "date-time" }
        }
      },
      "NoteCreateRequest": {
        "type": "object",
        "required": ["title", "markdown", "lifetimeDays"],
        "properties": {
          "title": {
            "type": "string",
            "description": "Краткое название заметки для отображения в списке и заголовке страницы"
          },
          "markdown": { "type": "string", "maxLength": 1048576 },
          "lifetimeDays": {
            "type": "integer",
            "enum": [7, 30, 90],
            "description": "Срок жизни заметки; expiredAt вычисляется сервером"
          }
        }
      },
      "NoteUpdateRequest": {
        "type": "object",
        "required": ["revision"],
        "properties": {
          "title": {
            "type": "string",
            "description": "Новое название заметки; поле передается только при его изменении"
          },
          "markdown": { "type": "string" },
          "revision": { "type": "integer", "format": "int64" }
        }
      },
      "TokenCreateRequest": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["READ", "WRITE"],
            "description": "READ разрешает только чтение; WRITE разрешает чтение и изменение заметки"
          },
          "expiresInMinutes": { "type": "integer", "nullable": true }
        }
      },
      "Token": {
        "type": "object",
        "required": ["token", "type"],
        "properties": {
          "token": {
            "type": "string",
            "description": "Share-токен, возвращаемый только при создании; на сервере хранится его хэш"
          },
          "type": {
            "type": "string",
            "enum": ["READ", "WRITE"],
            "description": "READ разрешает только чтение; WRITE разрешает чтение и изменение заметки"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Время истечения токена в UTC; null означает отсутствие срока"
          }
        }
      }
    }
  }
}
